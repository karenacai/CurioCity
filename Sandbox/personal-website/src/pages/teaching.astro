---
import Layout from '../layouts/Layout.astro';
// Import images
import cruiseCarBg from '../assets/cruise-car-bg.png';
import healthyCollabImage from '../assets/teaching-healthy-collab.png';
import appDev from '../assets/appdev.png';
// Import project image (you'll need to add this to your assets)
import plotPulseImage from '../assets/plotpulse.png';
// Import your new image
import newImage from '../assets/your-new-image.png';

const courses = [
  {
    title: "How to Develop Apps with AI",
    description: "Learn how to use the latest AI developer tools to supercharge your app development.",
    students: "Coming soon!",
    duration: "N/A",
    image: appDev.src,
    link: "https://joincuriocity.com/"
  },
  {
    title: "Cruise Self-Driving Car Stack (Behaviors 101/201)",
    description: "Onboarded employees at Cruise on the end-to-end architectural design of the self-driving car stack and standard engineering workflows.",
    students: "250+ students",
    duration: "16 weeks",
    image: cruiseCarBg.src,
    link: "https://www.getcruise.com/"
  },
  {
    title: "Healthy Collaborations Workshop",
    description: "Teach students how to navigate academic collaborations in a productive, healthy, and effective way.",
    students: "30+ students",
    duration: "1 week",
    image: healthyCollabImage.src,
    link: "https://healthycollab.caltech.edu/"
  }
];

const projects = [
  {
    title: "PlotPulse",
    description: "Plot Pulse is an app that allows you to unlock the emotional response to every TV episode! It uses AI to analyze Reddit discussions about TV show episodes.",
    tech: "Next.js, ChatGPT, Supabase, Vercel",
    status: "Deployed",
    image: plotPulseImage.src,
    link: "https://plotpulse.us"
  }
];
---

<Layout title="Teaching - Karena X. Cai">
	<main class="min-h-screen bg-white pt-32">
		<div class="container mx-auto px-4 py-8 max-w-5xl">
			<!-- Teaching Section -->
			<h1 class="text-4xl font-bold mb-12">Teaching</h1>
			
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
				{courses.map(course => (
					<div class="bg-white rounded-lg border border-gray-100 shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col">
						<div class="h-48 w-full overflow-hidden flex items-center justify-center p-4">
							<img 
								src={course.image} 
								alt={course.title}
								class="w-full h-full object-contain"
							/>
						</div>
						<div class="p-6 flex flex-col flex-1">
							<h3 class="text-xl font-semibold mb-4 text-center">{course.title}</h3>
							<p class="text-gray-600 mb-4 text-center flex-grow">{course.description}</p>
							<div class="flex justify-center text-sm text-gray-500 mb-4">
								<span class="mr-4">{course.students}</span>
								<span>{course.duration}</span>
							</div>
							<div class="flex justify-center">
								<a 
									href={course.link}
									class="btn-primary"
								>
									Learn More →
								</a>
							</div>
						</div>
					</div>
				))}
			</div>

			<!-- Dividing Line -->
			<hr class="border-t border-gray-200 my-16" />

			<!-- Apps Section -->
			<h2 class="text-4xl font-bold mb-12">Apps</h2>
			
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{projects.map(project => (
					<div class="bg-white rounded-lg border border-gray-100 shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col">
						<div class="h-48 w-full overflow-hidden flex items-center justify-center p-4">
							<img 
								src={project.image} 
								alt={project.title}
								class="w-full h-full object-contain"
							/>
						</div>
						<div class="p-6 flex flex-col flex-1">
							<h3 class="text-xl font-semibold mb-4 text-center">{project.title}</h3>
							<p class="text-gray-600 mb-4 text-center flex-grow">{project.description}</p>
							<div class="flex justify-center text-sm text-gray-500 mb-4">
								<span class="mr-4">{project.tech}</span>
								<span>{project.status}</span>
							</div>
							<div class="flex justify-center">
								<a 
									href={project.link}
									class="btn-primary"
								>
									View Project →
								</a>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</main>
</Layout> 