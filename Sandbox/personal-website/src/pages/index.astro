---
import Layout from '../layouts/Layout.astro';
import infloraImage from '../assets/inflora2.png';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout title="Karena X. Cai">
	<main class="min-h-screen bg-white pt-40">
		<div class="container mx-auto px-4 py-8 max-w-5xl flex flex-col lg:flex-row gap-12 items-center">
			{/* Image Container */}
			<div class="w-full lg:w-1/3 relative">
				<img 
					src={infloraImage.src} 
					alt="Inflora background" 
					class="w-full object-contain opacity-90"
				/>
			</div>

			{/* Content Container */}
			<div class="flex-1 max-w-2xl">
				<div class="flex items-baseline gap-4 mb-8">
					<h1 class="text-4xl font-bold">Karena X. Cai</h1>
					<h2 class="text-2xl text-gray-600">PhD</h2>
				</div>
				
				
				
				<p class="text-lg mb-8">
					I am crafting the ultimate hands-on AI course, one that is practical, immersive, and built to empower you. Let's build the future together.
				</p>
				
				<a 
					href="https://joincuriocity.com" 
					class="btn-primary mb-12"
				>
					Try the course here! →
				</a>
				<div class="flex gap-4 mb-8">
					<a 
						href="https://www.linkedin.com/in/karena-cai-8208a336" 
						class="text-gray-600 hover:text-gray-900 transition-colors"
						target="_blank"
						rel="noopener noreferrer"
					>
						<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
					</a>
					<a 
						href="https://github.com/karenacai" 
						class="text-gray-600 hover:text-gray-900 transition-colors"
						target="_blank"
						rel="noopener noreferrer"
					>
						<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
						</svg>
					</a>
					<a 
						href="https://cai-karena.medium.com/" 
						class="text-gray-600 hover:text-gray-900 transition-colors"
						target="_blank"
						rel="noopener noreferrer"
					>
						<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
							<path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
						</svg>
					</a>
					<a 
						href="https://scholar.google.com/citations?user=xTerCDkAAAAJ&hl=en&oi=ao" 
						class="text-gray-600 hover:text-gray-900 transition-colors"
						target="_blank"
						rel="noopener noreferrer"
					>
						<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 24c6.627 0 12-5.373 12-12S18.627 0 12 0 0 5.373 0 12s5.373 12 12 12z"/>
							<path fill="white" d="M10.5 16.5h-4v-1.5h4v1.5zm6-3h-10v-1.5h10v1.5zm0-3h-10v-1.5h10v1.5zm0-3h-10v-1.5h10v1.5z"/>
						</svg>
					</a>
				</div>

				<blockquote class="mt-12 pl-4 border-l-4 border-gray-300 italic text-gray-600">
					"THE BEAUTIFUL THING ABOUT LEARNING IS THAT NO ONE CAN TAKE IT AWAY FROM YOU."
					<footer class="mt-2 text-sm">- B.B. King</footer>
				</blockquote>
			</div>
		</div>
	</main>
</Layout>
